{
    "ConnectionStrings": {
        "DefaultConnection": "REPLACE_WITH_PRODUCTION_CONNECTION_STRING"
    },
    "SeedSettings": {
        "SuperAdmin": {
            "Email": "REPLACE_WITH_PRODUCTION_SUPERADMIN_EMAIL",
            "Password": "REPLACE_WITH_PRODUCTION_SUPERADMIN_PASSWORD"
        },
        "Admin": {
            "Email": "REPLACE_WITH_PRODUCTION_ADMIN_EMAIL",
            "Password": "REPLACE_WITH_PRODUCTION_ADMIN_PASSWORD"
        },
        "Finance": {
            "Email": "REPLACE_WITH_PRODUCTION_FINANCE_EMAIL",
            "Password": "REPLACE_WITH_PRODUCTION_FINANCE_PASSWORD"
        },
        "Staff": {
            "Email": "REPLACE_WITH_PRODUCTION_STAFF_EMAIL",
            "Password": "REPLACE_WITH_PRODUCTION_STAFF_PASSWORD"
        }
    },
    "Security": {
        "UseSecureCookies": true
    },
    "Identity": {
        "RequireConfirmedEmail": true
    },
    "Authentication": {
        "Google": {
            "ClientId": "REPLACE_WITH_GOOGLE_CLIENT_ID",
            "ClientSecret": "REPLACE_WITH_GOOGLE_CLIENT_SECRET"
        }
    },
    "PayMongo": {
        "RequireWebhookSignature": true,
        "WebhookSecret": "REPLACE_WITH_REAL_WEBHOOK_SECRET",
        "ForceStartupWhenMissingWebhookSecret": true
    },
    "ForwardedHeaders": {
        "Enabled": true,
        "ForwardLimit": 1,
        "KnownProxies": [],
        "KnownNetworks": []
    },
    "Logging": {
        "LogLevel": {
            "Default": "Warning",
            "Microsoft.AspNetCore": "Error"
        }
    }
}